# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
# Set default charset
charset = utf-8

[*.php]
indent_style = space
indent_size = 4

[*.view.php]
indent_style = space
indent_size = 2

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

# Indentation override for all JS under lib directory
[lib/**.js]
indent_style = space
indent_size = 2

# Matches the exact files either package.json or deno.json
[{package.json,deno.json}]
indent_style = space
indent_size = 2

[{composer.json}]
indent_style = space
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2
